# ---------- Server ----------
NODE_ENV=development
PORT=5000

# Allowed frontend origin(s) for CORS (comma-separated for multiple)
CLIENT_URL=http://localhost:5173


# ---------- MongoDB ----------
# Example:
# mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string


# ---------- Auth (admin dashboard) ----------
# Generate a long random string (32+ characters)
JWT_SECRET=your_long_random_jwt_secret
JWT_EXPIRES_IN=7d

# Used by the seed script to create the admin account
ADMIN_EMAIL=your_email@example.com
ADMIN_PASSWORD=your_secure_password


# ---------- GitHub (optional) ----------
# Public API works without a token; a token only raises rate limits
GITHUB_USERNAME=your_github_username
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_CACHE_TTL_MINUTES=30


# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
